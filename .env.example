# Copy to .env.local (git-ignored) and edit. Create React App only exposes
# variables prefixed REACT_APP_, and inlines them at build time — changing one
# requires a rebuild, not a restart.

# Port the dev server binds. The Rails API defaults to 3000, so the client
# takes 3001.
PORT=3001

# Where the event_management_app_BE API is reachable. Leave this blank and the
# client runs against local fixtures instead (see REACT_APP_DEMO below).
# The API must send `Access-Control-Expose-Headers: Authorization` or the
# browser cannot read the login token at all.
REACT_APP_API_BASE_URL=http://localhost:3000

# Force the local fixture backend on or off. When unset, demo mode is on
# whenever REACT_APP_API_BASE_URL is empty.
# REACT_APP_DEMO=true

# Cards per page. The API caps per_page at 100 and defaults to 50.
REACT_APP_PAGE_SIZE=8
